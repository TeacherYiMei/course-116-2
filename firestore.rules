rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function teacherExists() {
      return signedIn() &&
        exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }

    function teacherData() {
      return get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return teacherExists() &&
        teacherData().role == "admin";
    }

    function isTeacher() {
      return teacherExists() &&
        (teacherData().role == "teacher" || teacherData().role == "admin");
    }

    function teachesClass(className) {
      return isAdmin() ||
        (
          isTeacher() &&
          ("classes" in teacherData()) &&
          className in teacherData().classes
        );
    }

    match /students/{studentUid} {
      // 學生只能讀自己的資料。
      // 一般教師只能讀自己被分配班級的學生。
      // admin 可以讀所有學生。
      allow get: if signedIn() &&
        (
          request.auth.uid == studentUid ||
          isAdmin() ||
          teachesClass(resource.data.className)
        );

      // Firestore 查詢必須搭配班級條件。
      // 一般教師的前端只會查詢授權班級。
      allow list: if isAdmin() ||
        (
          isTeacher() &&
          ("classes" in teacherData()) &&
          resource.data.className in teacherData().classes
        );

      // 學生只能建立自己的文件。
      allow create: if signedIn() &&
        request.auth.uid == studentUid;

      // 學生可更新自己的文件。
      // 任課教師可維護自己授權班級，但若修改班級，
      // 修改前與修改後的班級都必須在其授權範圍內。
      allow update: if signedIn() &&
        (
          request.auth.uid == studentUid ||
          isAdmin() ||
          (
            isTeacher() &&
            teachesClass(resource.data.className) &&
            teachesClass(request.resource.data.className)
          )
        );

      // 任課教師只能刪除自己授權班級的錯誤學生紀錄。
      // admin 可刪除所有班級。
      allow delete: if isAdmin() ||
        (
          isTeacher() &&
          teachesClass(resource.data.className)
        );
    }

    match /teachers/{teacherUid} {
      // 教師只能讀自己的權限設定。
      // admin 可讀所有教師設定。
      allow get: if signedIn() &&
        (request.auth.uid == teacherUid || isAdmin());

      allow list: if isAdmin();

      // 前端不可自行提升權限或改班級。
      allow write: if false;
    }
  }
}
