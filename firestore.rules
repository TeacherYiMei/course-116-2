rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function teacherExists() {
      return signedIn() &&
        exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }

    function teacherData() {
      return get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return teacherExists() &&
        teacherData().role == "admin";
    }

    function isTeacher() {
      return teacherExists() &&
        (teacherData().role == "teacher" || teacherData().role == "admin");
    }

    function teachesClass(className) {
      return isAdmin() ||
        (
          isTeacher() &&
          ("classes" in teacherData()) &&
          className in teacherData().classes
        );
    }

    // ===== Python 學習冒險 =====
    match /students/{studentUid} {

      allow get: if signedIn() &&
        (
          request.auth.uid == studentUid ||
          isAdmin() ||
          teachesClass(resource.data.className)
        );

      allow list: if isAdmin() ||
        (
          isTeacher() &&
          ("classes" in teacherData()) &&
          resource.data.className in teacherData().classes
        );

      // 第一次建立自己的紀錄。
      allow create: if signedIn() &&
        request.auth.uid == studentUid;

      // 學生可以同步自己的學習進度，但不能改班級、座號、姓名。
      // 教師才可以更正身分資料。
      allow update: if signedIn() &&
        (
          (
            request.auth.uid == studentUid &&
            request.resource.data.className == resource.data.className &&
            request.resource.data.seatNo == resource.data.seatNo &&
            request.resource.data.name == resource.data.name
          )
          ||
          isAdmin()
          ||
          (
            isTeacher() &&
            teachesClass(resource.data.className) &&
            teachesClass(request.resource.data.className)
          )
        );

      allow delete: if isAdmin() ||
        (
          isTeacher() &&
          teachesClass(resource.data.className)
        );
    }

    // ===== 期中考複習關卡 =====
    match /midtermStudents/{studentUid} {

      allow get: if signedIn() &&
        (
          request.auth.uid == studentUid ||
          isAdmin() ||
          teachesClass(resource.data.className)
        );

      allow list: if isAdmin() ||
        (
          isTeacher() &&
          ("classes" in teacherData()) &&
          resource.data.className in teacherData().classes
        );

      allow create: if signedIn() &&
        request.auth.uid == studentUid &&
        request.resource.data.courseId == "midterm-review";

      allow update: if signedIn() &&
        (
          (
            request.auth.uid == studentUid &&
            request.resource.data.className == resource.data.className &&
            request.resource.data.seatNo == resource.data.seatNo &&
            request.resource.data.name == resource.data.name
          )
          ||
          isAdmin()
          ||
          (
            isTeacher() &&
            teachesClass(resource.data.className) &&
            teachesClass(request.resource.data.className)
          )
        );

      allow delete: if isAdmin() ||
        (
          isTeacher() &&
          teachesClass(resource.data.className)
        );
    }

    // ===== 教師權限 =====
    match /teachers/{teacherUid} {
      allow get: if signedIn() &&
        (request.auth.uid == teacherUid || isAdmin());

      allow list: if isAdmin();

      allow write: if false;
    }
  }
}
